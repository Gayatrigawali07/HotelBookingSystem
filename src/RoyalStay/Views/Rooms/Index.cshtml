@model IEnumerable<Room>
@{
    ViewData["Title"] = "Our Rooms";
    DateTime? ci = ViewBag.CheckIn as DateTime?;
    DateTime? co = ViewBag.CheckOut as DateTime?;
}
<section class="page-banner"><div class="container"><span class="eyebrow">YOUR STAY, YOUR WAY</span><h1>Explore our rooms</h1><p>Choose a room to match your plans and comfort.</p></div></section>
<section class="container section-space">
    @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
    @if (ci.HasValue && co.HasValue)
    {
        <div class="alert alert-info">Showing rooms available from <strong>@ci.Value.ToString("dd MMM yyyy")</strong> to <strong>@co.Value.ToString("dd MMM yyyy")</strong>. <a asp-action="Index">Clear dates</a></div>
    }
    <div class="row g-4">
        @if (!Model.Any())
        {
            <p class="text-muted">No rooms match your search. Try different dates or fewer guests.</p>
        }
        @foreach (var room in Model)
        {
            <div class="col-md-6 col-lg-4"><article class="room-card"><img src="@room.DisplayImage" alt="@room.RoomType"><div class="room-card-body"><h3>@room.RoomType</h3><p class="room-meta">Room @room.RoomNumber · Up to @room.Capacity Guests</p><p class="room-description">@room.Description</p><div class="d-flex justify-content-between align-items-center"><span class="room-price">₹@room.Price.ToString("N0")<small>/night</small></span><a class="btn btn-brand" asp-action="Details" asp-route-id="@room.RoomId" asp-route-checkIn="@(ci?.ToString("yyyy-MM-dd"))" asp-route-checkOut="@(co?.ToString("yyyy-MM-dd"))">View Details</a></div></div></article></div>
        }
    </div>
</section>
