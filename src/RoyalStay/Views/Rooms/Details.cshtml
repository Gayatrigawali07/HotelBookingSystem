@model Room
@{
    ViewData["Title"] = Model.RoomType;
    DateTime? ci = ViewBag.CheckIn as DateTime?;
    DateTime? co = ViewBag.CheckOut as DateTime?;
}
<section class="container section-space"><p class="breadcrumb-text"><a asp-controller="Home" asp-action="Index">Home</a> / <a asp-action="Index">Rooms</a> / @Model.RoomType</p><div class="row g-5"><div class="col-lg-7"><img class="detail-image" src="@Model.DisplayImage" alt="@Model.RoomType"></div><div class="col-lg-5"><div class="d-flex justify-content-between align-items-start gap-3"><h1 class="detail-title">@Model.RoomType</h1><span class="room-price text-nowrap">₹@Model.Price.ToString("N0")<small>/night</small></span></div><p class="room-meta">Room @Model.RoomNumber · ♙ Up to @Model.Capacity Guests</p><hr class="soft-rule"><h4>About this room</h4><p class="body-copy">@Model.Description</p><h4 class="mt-4">Room amenities</h4><div class="amenity-grid mt-3"><span>✓ Free Wi-Fi</span><span>✓ Air Conditioner</span><span>✓ Television</span><span>✓ Room Service</span><span>✓ Hot Water</span><span>✓ Wardrobe</span></div><hr class="soft-rule"><h4>Plan your stay</h4><form asp-controller="Bookings" asp-action="Create" method="get" id="detailBookingForm"><input type="hidden" name="roomId" value="@Model.RoomId"><div class="row g-3 mt-1"><div class="col-6"><label class="form-label" for="detailCheckIn">Check-in</label><input class="form-control" type="date" id="detailCheckIn" name="checkIn" value="@ci?.ToString("yyyy-MM-dd")" required></div><div class="col-6"><label class="form-label" for="detailCheckOut">Check-out</label><input class="form-control" type="date" id="detailCheckOut" name="checkOut" value="@co?.ToString("yyyy-MM-dd")" required></div></div><button class="btn btn-brand btn-lg w-100 mt-4">Book This Room</button></form></div></div></section>
