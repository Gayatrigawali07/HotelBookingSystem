@{ ViewData["Title"] = "Error"; }
<section class="container section-space text-center"><h1>Something went wrong</h1>@if (ViewData["IsDatabaseError"] is true){<p class="text-muted">The booking database is not reachable right now. Please try again in a moment.</p><p class="small text-muted">Site owner: check the connection string in appsettings.json and that database/HotelBookingDB.sql has been run.</p>}else{<p class="text-muted">Sorry, we could not complete your request. Please try again.</p>}@if (ViewData["RequestId"] is string rid){<p class="small text-muted">Request ID: @rid</p>}<a class="btn btn-brand" asp-controller="Home" asp-action="Index">Back to home</a></section>
