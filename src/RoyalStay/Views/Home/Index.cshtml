@model IEnumerable<Room>
@{
    ViewData["Title"] = "Find Your Stay";
    var rooms = Model;
}
<section class="hero"><div class="hero-shade"></div><div class="container hero-content"><span class="eyebrow">WELCOME TO ROYAL STAY</span><h1>Comfortable Stay,<br><em>Memorable Experience</em></h1><p>Find a room that suits your next trip, with comfort and thoughtful hospitality.</p><a class="btn btn-brand btn-lg mt-2" asp-controller="Rooms" asp-action="Index">Explore Rooms →</a></div></section>
<section class="container search-panel-wrap"><form class="search-panel row g-3 align-items-end" asp-controller="Rooms" asp-action="Index" method="get" id="roomSearchForm"><div class="col-12 col-md-4"><label class="form-label" for="checkIn">Check-in</label><input class="form-control" type="date" id="checkIn" name="checkIn" required></div><div class="col-12 col-md-4"><label class="form-label" for="checkOut">Check-out</label><input class="form-control" type="date" id="checkOut" name="checkOut" required></div><div class="col-6 col-md-2"><label class="form-label" for="guests">Guests</label><select class="form-select" id="guests" name="guests"><option value="1">1 Guest</option><option value="2" selected>2 Guests</option><option value="3">3 Guests</option><option value="4">4 Guests</option></select></div><div class="col-6 col-md-2 d-grid"><button class="btn btn-brand">Search Rooms</button></div></form></section>
<section class="container section-space"><div class="section-heading"><div><span class="eyebrow">REST & RECHARGE</span><h2>Rooms made for you</h2></div><a class="text-link" asp-controller="Rooms" asp-action="Index">View all rooms →</a></div><div class="row g-4">@if(!rooms.Any()){<p class="text-muted">No rooms are available right now. Please check back soon.</p>}@foreach(var room in rooms){<div class="col-md-4"><article class="room-card"><img src="@room.DisplayImage" alt="@room.RoomType"><div class="room-card-body"><div class="d-flex justify-content-between gap-2"><h3>@room.RoomType</h3><span class="room-price">₹@room.Price.ToString("N0")<small>/night</small></span></div><p class="room-meta">Room @room.RoomNumber · Up to @room.Capacity Guests</p><p class="room-description">@room.Description</p><a class="btn btn-outline-brand w-100" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.RoomId">View Details</a></div></article></div>}</div></section>
<section class="benefits-section" id="about"><div class="container py-5"><div class="row g-4"><div class="col-6 col-lg-3"><div class="benefit"><span>♧</span><h4>Best Price</h4><p>Comfort and value in every stay.</p></div></div><div class="col-6 col-lg-3"><div class="benefit"><span>✓</span><h4>Flexible Plans</h4><p>Clear booking information.</p></div></div><div class="col-6 col-lg-3"><div class="benefit"><span>◷</span><h4>Guest Support</h4><p>Help when you need it.</p></div></div><div class="col-6 col-lg-3"><div class="benefit"><span>♢</span><h4>Secure Booking</h4><p>Thoughtful guest experience.</p></div></div></div></div></section>
