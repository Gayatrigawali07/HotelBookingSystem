@model BookingFormViewModel
@{ ViewData["Title"] = "Complete Booking"; }
<section class="page-banner"><div class="container"><span class="eyebrow">ONE STEP CLOSER</span><h1>Complete your booking</h1><p>Enter your details to continue.</p></div></section>
<section class="container section-space"><div class="row g-4 justify-content-center"><div class="col-lg-4"><aside class="booking-summary"><h3>Your selection</h3><h4 class="mt-3">@Model.RoomName</h4><p class="room-meta">Up to @Model.RoomCapacity guests · Hotel stay</p><hr><div class="summary-line"><span>Price per night</span><strong>₹@Model.PricePerNight.ToString("N0")</strong></div><div class="summary-line"><span>Check-in</span><strong id="summaryCheckIn">@(Model.CheckIn?.ToString("yyyy-MM-dd") ?? "Select date")</strong></div><div class="summary-line"><span>Check-out</span><strong id="summaryCheckOut">@(Model.CheckOut?.ToString("yyyy-MM-dd") ?? "Select date")</strong></div><div class="summary-line total-line"><span>Estimated total (<span id="nightsText">1 night</span>)</span><strong id="estimatedTotal" data-price="@Model.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)">₹@Model.PricePerNight.ToString("N0")</strong></div><p class="small text-muted">The final price and availability are checked again on the server when you confirm. Maximum stay: 30 nights.</p></aside></div><div class="col-lg-7"><div class="form-card"><h2>Guest details</h2><p class="text-muted">Please use accurate contact information.</p><form asp-action="Create" method="post" id="bookingForm"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="RoomId" type="hidden"><input asp-for="RoomName" type="hidden"><input asp-for="PricePerNight" type="hidden"><input asp-for="RoomCapacity" type="hidden"><div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label">Full name *</label><input asp-for="FullName" class="form-control" placeholder="Enter your full name"><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label">Email *</label><input asp-for="Email" class="form-control" placeholder="you@example.com"><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label">Phone number *</label><input asp-for="Phone" class="form-control" placeholder="10-digit mobile number"><span asp-validation-for="Phone" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Guests" class="form-label">Number of guests *</label><select asp-for="Guests" class="form-select">@for (var g = 1; g <= Model.RoomCapacity; g++){<option value="@g">@g Guest@(g > 1 ? "s" : "")</option>}</select><span asp-validation-for="Guests" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CheckIn" class="form-label">Check-in *</label><input asp-for="CheckIn" type="date" class="form-control" value="@Model.CheckIn?.ToString("yyyy-MM-dd")"><span asp-validation-for="CheckIn" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CheckOut" class="form-label">Check-out *</label><input asp-for="CheckOut" type="date" class="form-control" value="@Model.CheckOut?.ToString("yyyy-MM-dd")"><span asp-validation-for="CheckOut" class="text-danger small"></span></div></div><div class="notice mt-4">Please confirm that your dates and guest details are correct.</div><button class="btn btn-brand btn-lg w-100 mt-4">Confirm Booking</button></form></div></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
