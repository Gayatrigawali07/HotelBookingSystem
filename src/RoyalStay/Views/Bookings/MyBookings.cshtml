@model IEnumerable<Booking>
@{
    ViewData["Title"] = "My Bookings";
    var email = ViewBag.Email as string;
    var phone = ViewBag.Phone as string;
    bool searched = ViewBag.Searched == true;
}
<section class="page-banner"><div class="container"><span class="eyebrow">YOUR TRAVEL PLANS</span><h1>My bookings</h1><p>Enter the email and phone number you used when booking to see your reservations.</p></div></section>
<section class="container section-space">
    @if (TempData["Notice"] is string notice) { <div class="alert alert-info">@notice</div> }
    <div class="table-card mb-4">
        <form method="get" asp-action="MyBookings" class="row g-3 align-items-end">
            <div class="col-md-5"><label class="form-label" for="email">Your email</label><input class="form-control" type="email" id="email" name="email" value="@email" placeholder="you@example.com" required maxlength="150"></div>
            <div class="col-md-4"><label class="form-label" for="phone">Phone number</label><input class="form-control" type="tel" id="phone" name="phone" value="@phone" placeholder="10-digit mobile number" required maxlength="20" pattern="[6-9][0-9]{9}" title="10-digit Indian mobile number"></div>
            <div class="col-md-3 d-grid"><button class="btn btn-brand">Find my bookings</button></div>
        </form>
    </div>
    @if (searched)
    {
        <div class="table-card"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h2 class="mb-0">Booking history</h2><a class="btn btn-brand" asp-controller="Rooms" asp-action="Index">Book a room</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Booking ID</th><th>Room</th><th>Check-in</th><th>Check-out</th><th>Guests</th><th>Total</th><th>Status</th></tr></thead><tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-muted p-4">No bookings found for this email and phone number.</td></tr>
        }
        else
        {
            foreach (var b in Model)
            {
                <tr><td>#@b.BookingId.ToString("0000")</td><td>@b.RoomType (Room @b.RoomNumber)</td><td>@b.CheckIn.ToString("dd MMM yyyy")</td><td>@b.CheckOut.ToString("dd MMM yyyy")</td><td>@b.Guests</td><td>₹@b.TotalAmount.ToString("N0")</td><td><span class="status-pill status-@b.Status.ToLower()">@b.Status</span></td></tr>
            }
        }
        </tbody></table></div></div>
    }
</section>
