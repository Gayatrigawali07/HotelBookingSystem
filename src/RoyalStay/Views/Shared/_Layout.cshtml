<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Royal Stay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header sticky-top">
    <nav class="navbar navbar-expand-lg container py-3">
        <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">♛</span> Royal Stay</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Rooms" asp-action="Index">Rooms</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="MyBookings">My Bookings</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About Us</a></li>
                <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="AdminRooms" asp-action="Index">Manage Rooms</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="AdminBookings" asp-action="Index">Manage Bookings</a></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-brand ms-lg-2">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="btn btn-outline-brand ms-lg-2" asp-controller="Account" asp-action="Login">Admin Login</a></li>
                }
            </ul>
        </div>
    </nav>
</header>
<main>@RenderBody()</main>
<footer class="site-footer" id="contact">
    <div class="container py-5"><div class="row g-4">
        <div class="col-md-4"><a class="footer-brand" asp-controller="Home" asp-action="Index">♛ Royal Stay</a><p class="footer-muted mt-3">Experience comfort and thoughtful hospitality. Find a room that feels like home.</p></div>
        <div class="col-6 col-md-2"><h6>Quick Links</h6><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Rooms" asp-action="Index">Rooms</a><a asp-controller="Bookings" asp-action="MyBookings">My Bookings</a></div>
        <div class="col-6 col-md-3"><h6>Contact Us</h6><p class="footer-muted">123, MG Road, Pune, Maharashtra<br>+91 98765 43210<br>info@royalstay.example</p></div>
        <div class="col-md-3"><h6>Need help?</h6><p class="footer-muted">Questions about a stay? Write to us and we will reply.</p><a class="btn btn-brand w-100" href="mailto:info@royalstay.example">Email the hotel</a></div>
    </div><hr class="footer-line"><p class="text-center footer-muted small mb-0">© @DateTime.Now.Year Royal Stay. Hotel Room Booking System.</p></div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
