@model Room
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="RoomNumber" class="form-label"></label><input asp-for="RoomNumber" class="form-control" maxlength="20"><span asp-validation-for="RoomNumber" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="RoomType" class="form-label"></label><input asp-for="RoomType" class="form-control" maxlength="100" placeholder="e.g. Deluxe Room"><span asp-validation-for="RoomType" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" type="number" step="0.01" min="1"><span asp-validation-for="Price" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control" type="number" min="1" max="10"><span asp-validation-for="Capacity" class="text-danger small"></span></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3" maxlength="1000"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
    <div class="col-12"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" maxlength="500" placeholder="https://..."><span asp-validation-for="ImageUrl" class="text-danger small"></span></div>
    <div class="col-12"><div class="form-check"><input asp-for="IsAvailable" class="form-check-input"><label asp-for="IsAvailable" class="form-check-label"></label></div></div>
</div>
