@model IEnumerable<Room>
@{ ViewData["Title"] = "Manage Rooms"; }
<section class="page-banner"><div class="container"><span class="eyebrow">ADMIN</span><h1>Manage rooms</h1><p>Add, edit or remove rooms.</p></div></section>
<section class="container section-space">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
    <div class="table-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h2 class="mb-0">All rooms</h2><div class="d-flex gap-2"><a class="btn btn-outline-brand" asp-controller="AdminBookings" asp-action="Index">View bookings</a><a class="btn btn-brand" asp-action="Create">+ Add room</a></div></div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Room no.</th><th>Type</th><th>Price / night</th><th>Guests</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
        @if (!Model.Any()) { <tr><td colspan="6" class="text-muted p-4">No rooms yet. Click "Add room".</td></tr> }
        @foreach (var r in Model)
        {
            <tr><td>@r.RoomNumber</td><td>@r.RoomType</td><td>₹@r.Price.ToString("N0")</td><td>@r.Capacity</td>
                <td>@if (r.IsAvailable){<span class="status-pill status-confirmed">Available</span>}else{<span class="status-pill status-cancelled">Hidden</span>}</td>
                <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-brand" asp-action="Edit" asp-route-id="@r.RoomId">Edit</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.RoomId">Delete</a></td></tr>
        }
        </tbody></table></div>
    </div>
</section>
