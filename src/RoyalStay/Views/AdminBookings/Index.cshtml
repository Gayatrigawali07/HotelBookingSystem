@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Manage Bookings";
    var filter = ViewBag.Status as string;
}
<section class="page-banner"><div class="container"><span class="eyebrow">ADMIN</span><h1>Manage bookings</h1><p>View all reservations and update their status.</p></div></section>
<section class="container section-space">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
    <div class="table-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="mb-0">Bookings</h2>
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All statuses</option>
                    @foreach (var s in BookingStatus.All) { <option value="@s" selected="@(s == filter)">@s</option> }
                </select>
                <a class="btn btn-outline-brand" asp-controller="AdminRooms" asp-action="Index">Rooms</a>
            </form>
        </div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>ID</th><th>Guest</th><th>Room</th><th>Check-in</th><th>Check-out</th><th>Nights</th><th>Guests</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody>
        @if (!Model.Any()) { <tr><td colspan="10" class="text-muted p-4">No bookings found.</td></tr> }
        @foreach (var b in Model)
        {
            <tr>
                <td>#@b.BookingId.ToString("0000")</td>
                <td>@b.GuestName<br><small class="text-muted">@b.GuestEmail @b.GuestPhone</small></td>
                <td>@b.RoomType<br><small class="text-muted">Room @b.RoomNumber</small></td>
                <td>@b.CheckIn.ToString("dd MMM yyyy")</td><td>@b.CheckOut.ToString("dd MMM yyyy")</td><td>@b.Nights</td><td>@b.Guests</td>
                <td>₹@b.TotalAmount.ToString("N0")</td>
                <td><span class="status-pill status-@b.Status.ToLower()">@b.Status</span></td>
                <td>
                    <form asp-action="UpdateStatus" asp-route-id="@b.BookingId" method="post" class="d-flex gap-1">
                        <input type="hidden" name="filter" value="@filter" />
                        <select name="status" class="form-select form-select-sm" style="min-height:34px">
                            @foreach (var s in BookingStatus.All) { <option value="@s" selected="@(s == b.Status)">@s</option> }
                        </select>
                        <button class="btn btn-sm btn-brand">Save</button>
                    </form>
                </td>
            </tr>
        }
        </tbody></table></div>
    </div>
</section>
